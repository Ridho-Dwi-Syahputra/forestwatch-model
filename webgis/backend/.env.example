# Salin ke .env dan sesuaikan nilainya

# Path ke folder data (7 file kontrak dari Orang 1)
DATA_DIR=./data

# CORS — pisahkan dengan koma kalau lebih dari satu
# Development: localhost Vite
# Production: URL Vercel/Netlify frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Port server (default 8000)
PORT=8000

# === Fitur "Analisis Wilayah Custom" (POST /api/analyze) ===
# Kosongkan GEE_SERVICE_ACCOUNT_* untuk MENONAKTIFKAN endpoint ini (sisa API tetap jalan normal,
# /api/analyze akan respond 503 dengan pesan jelas).
GEE_PROJECT=forestwatch-papua-unand
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-service-account.json

# Checkpoint model (.pt) -- salin best_model.pt hasil training Orang 1 ke backend/data/
MODEL_CHECKPOINT_PATH=./data/best_model.pt
MODEL_ARCHITECTURE=unet_scse
MODEL_ENCODER_NAME=resnet50

# Batas sisi AOI custom (km) -- jaga waktu respons + ukuran download GEE wajar saat demo
ANALYZE_MAX_SIDE_KM=20
