# ============================================================================
# Overview environment variable repo WebGIS. Ada DUA file .env terpisah:
#
#   1. backend/.env   -> config FastAPI (lihat backend/.env.example, paling lengkap)
#   2. frontend/.env  -> VITE_API_URL (lihat frontend/.env.example)
#
# File root ini hanya ringkasan/rujukan. Salin masing-masing .env.example di
# subfolder-nya, bukan file ini.
# ============================================================================

# --- Backend (backend/.env) ---
# DATA_DIR=./data
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# GEE_PROJECT=forestwatch-papua-unand
# GEE_SERVICE_ACCOUNT_EMAIL=            # kosong = /api/analyze nonaktif (503), API lain tetap jalan
# GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-service-account.json
# MODEL_CHECKPOINT_PATH=./data/best_model.pt
# MODEL_ARCHITECTURE=unet_scse
# MODEL_ENCODER_NAME=resnet50
# ANALYZE_MAX_SIDE_KM=20

# --- Frontend (frontend/.env) ---
# VITE_API_URL=                          # kosong = pakai dummy-data lokal
