# Salin file ini menjadi `.env` dan isi nilainya. `.env` tidak di-commit ke git.

# Google Earth Engine project ID
GEE_PROJECT=forestwatch-papua-unand

# Path lokal untuk patches dataset (default: ./data/patches)
DATA_DIR=./data

# Path lokal untuk output 7 file kontrak (default: ./outputs)
OUTPUT_DIR=./outputs

# Path Google Drive (di Colab): mount path
DRIVE_ROOT=/content/drive/MyDrive

# Path subfolder di Drive
DRIVE_TILES_T1=ForestWatch_Tiles_T1
DRIVE_TILES_T2=ForestWatch_Tiles_T2
DRIVE_PATCHES=ForestWatch_Patches
DRIVE_OUTPUTS=ForestWatch_Outputs
DRIVE_MASKS=ForestWatch_Masks

# Random seed (untuk reproduktibilitas)
SEED=42
